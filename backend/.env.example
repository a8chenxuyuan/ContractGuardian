# 合同卫士后端环境配置模板 —— 复制为 .env 后填入真实值（.env 已被 .gitignore 排除，严禁提交或随包分发）

# ---- 数据库（PostgreSQL；端口按本机错峰设置，默认库需先创建）----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/contract_guard_v2
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/contract_guard_v2

# ---- Redis（Pub/Sub 与验证码缓存）----
REDIS_URL=redis://localhost:6380/0

# ---- Qdrant 向量库 ----
QDRANT_URL=http://localhost:16334
# QDRANT_API_KEY=

# ---- Neo4j（预留）----
NEO4J_URI=bolt://localhost:7687
NEO4J_PASSWORD=password

# ---- Hugging Face 镜像（首次下载 BGE-M3 / 重排模型加速）----
HF_ENDPOINT=https://hf-mirror.com

# ---- LLM（阿里百炼 OpenAI 兼容端点）----
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-flash
# 视觉模型：图片合同 OCR 提取（qwen-vl 系列/OCR 系列免费额度可能耗尽，omni 系列实测有配额）
LLM_VL_MODEL=qwen3.8-omni-flash

# ---- Tavily 联网搜索（法规原文检索与动态缓存）https://tavily.com ----
TAVILY_API_KEY=tvly-dev-xxxx
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=advanced

# ---- SMTP 邮件（忘记密码验证码；未配置时该功能返回 503）----
# 以 QQ 邮箱为例：SMTP_HOST=smtp.qq.com，SMTP_PORT=465，SMTP_PASSWORD 为授权码（设置-账户-开启SMTP获取，非登录密码）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- 应用 ----
# AUTO_CREATE_TABLES=true 时启动自动建表（开发兜底，只建表不加列；生产建议关闭走 Alembic）
AUTO_CREATE_TABLES=true
